# =====================================================
# SiteSeed — Environment Variables
# =====================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it is gitignored.
#
# How to set up:
#   cp .env.example .env        (Mac/Linux)
#   copy .env.example .env      (Windows)
# Then edit .env with your actual values.
# =====================================================

# Flask secret key — used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Your Anthropic API key — required for Phase 5+ (content generation).
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override where generated preview sites are stored.
# Defaults to generated_sites/ inside the project root.
# GENERATED_SITES_DIR=
